# Settings for docker-compose.yml only (copy to .env next to it). The API's own settings stay in apps/api/.env.
# All optional: the defaults below are for local use. Use long URL-safe passwords for anything real.

# Image tag for facex-backend / facex-frontend
FACEX_TAG=latest

# API mode: production (default, slim image) or development (adds devDependencies, allows STORAGE_DRIVER=local).
# Overrides NODE_ENV from apps/api/.env. Rebuild after changing: docker compose up -d --build
API_NODE_ENV=production

# PostgreSQL. The FACEX_* passwords are applied only when the db volume is first created;
# changing them later needs ALTER ROLE in the database (or `docker compose down -v` to start over, which DELETES the data).
POSTGRES_PASSWORD=postgres
FACEX_DB_NAME=facex
FACEX_MIGRATOR_PASSWORD=facex_migrator_dev
FACEX_APP_PASSWORD=facex_app_dev

# Host ports
DB_PORT=5432
API_PORT=4000
WEB_PORT=3000

# Web build-time settings (baked into the facex-frontend image; rebuild after changing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_API_BASE_URL=
