# Demo Mode: a simulated face matcher on the event-day scanner, for live walkthroughs with no face provider.
# Leave unset (or false) for the client-facing product.
NEXT_PUBLIC_DEMO_MODE=false

# The public address of this site, e.g. https://facex.example.org. Used for absolute links in link previews.
# BUILD-TIME: NEXT_PUBLIC_* values are fixed when `next build` runs, so set them before building.
NEXT_PUBLIC_SITE_URL=

# --- Backend API (apps/api) ---
# Where this app proxies /api/v1 to. BUILD-TIME for `next build`/`next start` (Next bakes rewrites in), so set it before
# building. The API's FRONTEND_URL must include this app's own origin. In a deployment where a reverse proxy sends /api/v1
# straight to the API (recommended: docs/deployment.md) this proxy is simply never used.
API_ORIGIN=http://localhost:4000
# Leave unset to use the same-origin /api/v1 proxy. Set only to call an API on another origin directly
# (that also needs COOKIE_SAME_SITE=none and secure cookies on the API).
NEXT_PUBLIC_API_BASE_URL=


# Dev only: set true to register the service worker (needed to try push notifications) in `next dev`. Production always registers it.
NEXT_PUBLIC_REGISTER_SW=
