<mxfile host="app.diagrams.net">
  <diagram id="tuli-workflow" name="Tuli Workflow">
    <mxGraphModel dx="1500" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Tuli – Registration, Document Verification &amp;amp; Event-Day Attendance" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f3a5f;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1400" height="40" as="geometry" />
        </mxCell>

        <!-- ================= SECTION FRAMES ================= -->
        <mxCell id="regBg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#c9d3e0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="440" height="800" as="geometry" />
        </mxCell>
        <mxCell id="regHdr" value="&lt;b&gt;1. REGISTRATION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Student information, documents &amp;amp; payment&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="verBg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#c9d3e0;" vertex="1" parent="1">
          <mxGeometry x="520" y="70" width="440" height="800" as="geometry" />
        </mxCell>
        <mxCell id="verHdr" value="&lt;b&gt;2. DOCUMENT VERIFICATION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;&quot;&gt;After registration · Before event day&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="520" y="70" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="evBg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#c9d3e0;" vertex="1" parent="1">
          <mxGeometry x="1000" y="70" width="440" height="800" as="geometry" />
        </mxCell>
        <mxCell id="evHdr" value="&lt;b&gt;3. EVENT DAY&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Face scan &amp;amp; attendance&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1000" y="70" width="440" height="50" as="geometry" />
        </mxCell>

        <!-- ================= 1. REGISTRATION ================= -->
        <mxCell id="start" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="basic" value="&lt;b&gt;Basic Information Collection&lt;/b&gt;&lt;div style=&quot;text-align:left;padding-left:34px;margin-top:6px;&quot;&gt;1. First Name&lt;br&gt;2. Last Name&lt;br&gt;3. Date of Birth&lt;br&gt;4. Mobile Number&lt;br&gt;5. Email&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="docUp" value="&lt;b&gt;Document Upload&lt;/b&gt;&lt;div style=&quot;text-align:left;padding-left:34px;margin-top:6px;&quot;&gt;1. Birth Certificate&lt;br&gt;2. School ID&lt;br&gt;3. Transcript&lt;br&gt;4. California ID&lt;br&gt;5. Health Certificate&lt;br&gt;6. Parent Consent&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pay" value="Payment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="550" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="payOk" value="Payment&lt;br&gt;Successful?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="630" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="resume" value="Resume Registration Later" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="550" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="draft" value="Save as Draft" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="655" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="regDone" value="Registration Completed" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="770" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="start" target="basic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="basic" target="docUp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="docUp" target="pay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="pay" target="payOk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="No /&lt;br&gt;Interrupted" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontStyle=1;fontSize=11;fontColor=#b85450;labelBackgroundColor=#f7f9fc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="payOk" target="draft">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="draft" target="resume">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="resume" target="pay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontStyle=1;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="payOk" target="regDone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= 2. DOCUMENT VERIFICATION ================= -->
        <mxCell id="pending" value="Documents Pending&lt;br&gt;Verification" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="check" value="Manual Document Check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="220" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="Documents&lt;br&gt;Valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="resubmit" value="Student Re-submits&lt;br&gt;Documents for Re-check" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="220" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="reject" value="Reject Documents&lt;br&gt;with Reason Note" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="325" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="verified" value="Student Verified" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="440" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="approve" value="Mark as Approved" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="520" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="submit" value="Submit Approval" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="600" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="added" value="Student Added to&lt;br&gt;Approved Event-Day List" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="680" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="v1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="pending" target="check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="check" target="valid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#b85450;labelBackgroundColor=#f7f9fc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="valid" target="reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="reject" target="resubmit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;fontColor=#b85450;labelBackgroundColor=#f7f9fc;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="resubmit" target="check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontStyle=1;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="valid" target="verified">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="verified" target="approve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="approve" target="submit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="submit" target="added">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= 3. EVENT DAY ================= -->
        <mxCell id="evList" value="Approved Event-Day&lt;br&gt;Student List" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1040" y="140" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="scan" value="Face Scan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1040" y="240" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="match" value="Face Match?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1040" y="320" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="search" value="Search Student in Admin Panel&lt;br&gt;(Name / Date of Birth)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="340" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ident" value="Student Identified" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1040" y="460" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="manual" value="Manual Verification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="460" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="present" value="Mark Present" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1040" y="550" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="end" value="End" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1040" y="630" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="Approved students only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#1f3a5f;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="evList" target="scan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="scan" target="match">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontStyle=1;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="match" target="ident">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#b85450;labelBackgroundColor=#f7f9fc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="match" target="search">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;" edge="1" parent="1" source="search" target="manual">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="ident" target="present">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="manual" target="present">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="present" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= HAND-OFFS BETWEEN STAGES ================= -->
        <mxCell id="link1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f3a5f;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="regDone" target="pending">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="500" y="795" />
              <mxPoint x="500" y="165" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="link2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f3a5f;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="added" target="evList">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="710" />
              <mxPoint x="980" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ================= KEY RULES + LEGEND ================= -->
        <mxCell id="rules" value="&lt;b&gt;Key Rules&lt;/b&gt;&lt;br&gt;• If payment fails or is interrupted, the registration is saved as a draft and can be resumed later.&lt;br&gt;• Documents are checked manually after registration and before the event day.&lt;br&gt;• Invalid documents are rejected with a reason note; the student re-submits them and they are re-checked.&lt;br&gt;• Only approved students are on the event-day list and can proceed to the face scan.&lt;br&gt;• If the face match fails, the admin searches for the student by name or date of birth and verifies them manually." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa7b8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="900" height="110" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa7b8;" vertex="1" parent="1">
          <mxGeometry x="980" y="900" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="lgTitle" value="Legend" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="995" y="905" width="120" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lgStart" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="936" width="50" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lgStartT" value="Start / End / Stage status" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="936" width="160" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lgDec" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1230" y="934" width="50" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lgDecT" value="Decision (Yes / No)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="936" width="140" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lgStep" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1000" y="972" width="50" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lgStepT" value="Process step" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="972" width="160" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lgAlt" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1230" y="972" width="50" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lgAltT" value="Alternate / fallback path" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1290" y="972" width="150" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
