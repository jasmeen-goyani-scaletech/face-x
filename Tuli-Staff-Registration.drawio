        <mxCell id="lg2" value="" style="rhombus;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1125" y="604" width="50" height="28" as="geometry" /></mxCell>
        <mxCell id="lg2t" value="Decision (Yes / No)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1185" y="606" width="130" height="24" as="geometry" /></mxCell>
        <mxCell id="lg3" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="642" width="50" height="24" as="geometry" /></mxCell>
        <mxCell id="lg3t" value="Process step" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="642" width="160" height="24" as="geometry" /></mxCell>
