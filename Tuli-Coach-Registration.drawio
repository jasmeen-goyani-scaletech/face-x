        <mxCell id="reject" value="Mark as Rejected &amp;amp;&lt;br&gt;Notify Coach" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="325" width="135" height="50" as="geometry" /></mxCell>
        <mxCell id="approve" value="Mark as Approved" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="440" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="await" target="review"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="review" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a3" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#b85450;labelBackgroundColor=#f7f9fc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ok" target="reject"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="reject" target="reupload"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="reupload" target="review"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontStyle=1;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="ok" target="approve"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="approved" value="Coach Approved" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="140" width="190" height="50" as="geometry" /></mxCell>
