        <mxCell id="c4" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#b85450;labelBackgroundColor=#f7f9fc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="allUp" target="pending"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
