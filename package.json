{
  "name": "facex",
  "version": "0.1.0",
  "private": true,
  "description": "Face-X monorepo: Next.js web app (apps/web) and Express API (apps/api)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @facex/web --filter @facex/api dev",
    "dev:web": "pnpm --filter @facex/web dev",
    "dev:api": "pnpm --filter @facex/api dev",
    "build": "pnpm build:api && pnpm build:web",
    "build:web": "pnpm --filter @facex/web build",
    "build:api": "pnpm --filter @facex/api build",
    "start:web": "pnpm --filter @facex/web start",
    "start:api": "pnpm --filter @facex/api start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm lint && pnpm typecheck",
    "test": "pnpm -r --if-present test",
    "db:migrate": "pnpm --filter @facex/api db:migrate",
    "db:migrate:prod": "pnpm --filter @facex/api db:migrate:prod",
    "db:seed": "pnpm --filter @facex/api db:seed",
    "e2e": "pnpm --filter @facex/api e2e"
  }
}
