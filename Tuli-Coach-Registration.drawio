<mxfile host="app.diagrams.net">
  <diagram id="tuli-coach" name="Coach Registration">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="868" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Tuli – Coach Registration Workflow" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f3a5f;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1280" height="40" as="geometry" /></mxCell>
        <mxCell id="bg0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#c9d3e0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="400" height="620" as="geometry" /></mxCell>
        <mxCell id="hdr0" value="&lt;b&gt;1. REGISTRATION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Personal details &amp;amp; certificates · No payment&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="bg1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#c9d3e0;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="400" height="620" as="geometry" /></mxCell>
        <mxCell id="hdr1" value="&lt;b&gt;2. ADMIN VERIFICATION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Certificate review&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="bg2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#c9d3e0;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="400" height="620" as="geometry" /></mxCell>
        <mxCell id="hdr2" value="&lt;b&gt;3. EVENT-DAY ACCESS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Approved coaches only&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="start" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="190" height="40" as="geometry" /></mxCell>
        <mxCell id="reg" value="&lt;b&gt;Register&lt;/b&gt;&lt;br&gt;Personal details&lt;br&gt;&lt;i&gt;(no payment)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="190" height="70" as="geometry" /></mxCell>
