        <mxCell id="l2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f3a5f;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="approve" target="approved"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="465" /><mxPoint x="900" y="165" /></Array></mxGeometry></mxCell>
        <mxCell id="rules" value="&lt;b&gt;Key Rules&lt;/b&gt;&lt;br&gt;• Coaches register with personal details only – no payment is required.&lt;br&gt;• Required uploads: First Aid / CPR certificate, YALF Tackle certificate, and reference / proof of a Live Scan background check.&lt;br&gt;• If any certificate is missing, the coach’s status stays Pending.&lt;br&gt;• The admin reviews the certificates and marks the coach Approved or Rejected.&lt;br&gt;• Rejected coaches are notified and can re-upload their certificates for another review.&lt;br&gt;• Only approved coaches get event-day access." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa7b8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="820" height="118" as="geometry" /></mxCell>
        <mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa7b8;" vertex="1" parent="1"><mxGeometry x="880" y="720" width="440" height="110" as="geometry" /></mxCell>
        <mxCell id="lgTitle" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="895" y="725" width="120" height="24" as="geometry" /></mxCell>
        <mxCell id="lg1" value="" style="rounded=1;arcSize=50;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="900" y="756" width="50" height="24" as="geometry" /></mxCell>
