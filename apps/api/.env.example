# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# How many reverse proxies sit in front of the API (0 = none). The rate limits key on the real client address, which is
# read from X-Forwarded-For through this many proxies. Empty = 1 in production, 0 otherwise. Get this right in a deployment.
TRUST_PROXY_HOPS=

# PostgreSQL (managed or local). Set DATABASE_SSL=true if the provider requires TLS.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/facex
DATABASE_SSL=false
# When DATABASE_SSL=true: path to a CA certificate (PEM) to trust, e.g. for a self-signed database certificate. Empty = system CAs.
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=10

# Authentication. Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Two DIFFERENT random values of at least 32 characters. Backend only: never expose or commit them.
JWT_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh-token cookie. Use "none" (requires HTTPS) only if the frontend and API are on different sites.
COOKIE_SAME_SITE=lax
# COOKIE_SECURE defaults to true in production; set false only for plain-http local development.
COOKIE_SECURE=

# Browser origin(s) allowed by CORS and the cookie-endpoint Origin check. Comma-separated for several.
FRONTEND_URL=http://localhost:3000

# Where documents and photos are kept:
#   s3     any S3-compatible service (AWS S3, Hetzner Object Storage, MinIO, R2...): fill in the STORAGE_* group below
#   local  a folder on THIS machine (STORAGE_LOCAL_DIR). DEVELOPMENT ONLY: refused when NODE_ENV=production
#   empty  s3 if the group below is complete, otherwise uploads are switched off
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=
STORAGE_LOCAL_PUBLIC_URL=

# Private S3-compatible object storage (AWS S3, Cloudflare R2, MinIO...). Not used until the documents
# phase; set ACCESS_KEY, SECRET_KEY and BUCKET together. Leave STORAGE_ENDPOINT empty for AWS S3 itself.
STORAGE_ENDPOINT=https://<hetzner-endpoint>.your-objectstorage.com
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_FORCE_PATH_STYLE=true

# Largest registration document a family may upload (PDF, JPEG, PNG or DOCX), in bytes. Empty = 5 MiB; at most 10 MiB.
DOCUMENT_MAX_BYTES=

# Stripe (payments). Backend only; never expose either value. Without STRIPE_SECRET_KEY the payment endpoints answer 503.
# Create a webhook endpoint in the Stripe dashboard pointing at POST <API URL>/api/v1/webhooks/stripe and paste its signing secret here.
# Hosted Checkout needs no publishable key on the backend; the frontend never needs a Stripe key either.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web Push notifications (document accepted/rejected, event-day access). Generate the pair once with
#   npx web-push generate-vapid-keys
# Set all three or none. The public key is served to the browser; the private key is backend only. Keep the same keys across
# deployments or every existing subscription stops working. Without them, push is off and registration is unaffected.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Face recognition. FACE_PROVIDER names a registered adapter in src/infrastructure/face/provider-registry.ts. Registered:
#   rust-remote  the face_z_BE service (RUST_FACE_SERVICE_URL below): it owns the face vectors and files each scan frame
#   node-native  face-api (WASM) running inside this API, no cloud service and no native build. Leave it empty to turn face
# recognition off (enrollment and scanning then answer 503).
# FACE_CONSENT_CODE  the biometric consent that a guardian must have accepted before a photo is enrolled (BIOMETRIC_CONSENT is
#                    published in the consents table), or NONE to explicitly waive it. Unset keeps enrollment disabled.
# FACE_ENCRYPTION_KEY  node-native only: 32 random bytes, base64. Face descriptors are stored encrypted with it (AES-256-GCM).
#                    Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))". Keep it secret and
#                    backed up: without it every enrolled face is unreadable and people must be enrolled again.
# FACE_PROVIDER_API_KEY / FACE_PROVIDER_URL are reserved for hosted providers and unused by node-native. Backend only.
FACE_PROVIDER=rust-remote
# rust-remote: base URL of the face service including its /v1 prefix. Required when FACE_PROVIDER=rust-remote.
RUST_FACE_SERVICE_URL=https://facex-v2.scaletechsolutions.ai/v1
# rust-remote: the service ADMIN_TOKEN, which lets this API HARD-DELETE a person face data (when removed or a new photo replaces
# the old one). Required when NODE_ENV=production. Backend only.
RUST_FACE_SERVICE_TOKEN=
FACE_CONSENT_CODE=BIOMETRIC_CONSENT
FACE_ENCRYPTION_KEY=
FACE_PROVIDER_TIMEOUT_MS=15000
FACE_PROVIDER_API_KEY=
FACE_PROVIDER_URL=

# Event-day matching policy. Application-side (adapters never decide); similarity is 0..1, higher = closer. Empty = default.
# The defaults are PROVISIONAL: calibrate them against the chosen provider (false-accept / false-reject rates) before go-live.
#   FACE_MATCH_THRESHOLD   at or above this, one clearly-leading candidate is an automatic MATCH   (default 0.90)
#   FACE_REVIEW_THRESHOLD  from here up to the match threshold a person must look (REVIEW_REQUIRED) (default 0.75, must be <= match)
#   FACE_AMBIGUITY_MARGIN  the leader must beat the runner-up by this much, else REVIEW_REQUIRED   (default 0.05)
#   FACE_SCAN_TIMEOUT_MS   deadline for the provider's identify() call, 500-30000                   (default 5000)
FACE_MATCH_THRESHOLD=
FACE_REVIEW_THRESHOLD=
FACE_AMBIGUITY_MARGIN=
FACE_SCAN_TIMEOUT_MS=

# AI document field extraction (POST /api/v1/documents/:id/extract): reads names, dates of birth and expiry dates off an
# uploaded document and compares them with the profile. Empty EXTRACTION_PROVIDER = the endpoint answers 503.
#   EXTRACTION_PROVIDER          "openai" (the only adapter, src/infrastructure/extraction/provider-registry.ts)
#   OPENAI_API_KEY               required for openai. Backend only; never expose it
#   EXTRACTION_MODEL             default gpt-5.6-luna (fallback if that model refuses PDFs/DOCX: gpt-4.1-mini)
#   EXTRACTION_REASONING_EFFORT  none|minimal|low|medium|high, or "default" to send no setting (gpt-4.1-mini). Default none
#   EXTRACTION_TIMEOUT_MS        deadline per call, 5000-60000 (default 20000; keep it under the web app's 30 s request timeout)
# The document goes to the provider on every call (sent with store=false). See docs/document-verification-api.md.
EXTRACTION_PROVIDER=
OPENAI_API_KEY=
EXTRACTION_MODEL=
EXTRACTION_REASONING_EFFORT=
EXTRACTION_TIMEOUT_MS=

# Sign-up / sign-in limits per client address (empty = defaults: 60 sign-ups per hour, 200 sign-ins per 15 minutes).
# A venue's Wi-Fi puts many families behind one address, so do not set these low. The per-account limit (5 failed
# sign-ins per 15 minutes) is separate and always on.
RATE_LIMIT_REGISTER_PER_IP_HOUR=
RATE_LIMIT_LOGIN_PER_IP_15MIN=
