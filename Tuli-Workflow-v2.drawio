<mxfile host="app.diagrams.net">
  <diagram id="tuli-workflow-v2" name="Tuli Workflow v2">
    <mxGraphModel dx="900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="1880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Tuli – Registration to Attendance Workflow" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f3a5f;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="680" height="40" as="geometry" />
        </mxCell>

        <!-- Section backgrounds and headers -->
        <mxCell id="regBg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#c9d3e0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="680" height="910" as="geometry" />
        </mxCell>
        <mxCell id="regHdr" value="1. REGISTRATION FLOW" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="680" height="40" as="geometry" />
        </mxCell>
        <mxCell id="evBg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#c9d3e0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1020" width="680" height="830" as="geometry" />
        </mxCell>
        <mxCell id="evHdr" value="2. EVENT-DAY FLOW" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="1020" width="680" height="40" as="geometry" />
        </mxCell>

        <!-- ================= REGISTRATION ================= -->
        <mxCell id="start" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="130" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="basic" value="Basic Information Collection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="200" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="docCol" value="Document Collection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="280" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="docVer" value="Document Verification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="360" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="docOk" value="Documents&lt;br&gt;Approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="440" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="docUpd" value="Ask Student/Parent to&lt;br&gt;Update Documents" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="465" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pay" value="Payment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="580" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="payOk" value="Payment&lt;br&gt;Successful?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="660" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="draft" value="Save as Draft" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="685" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="resume" value="Resume Registration Later" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="580" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="regDone" value="Registration Completed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="800" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="added" value="Student Added to&lt;br&gt;Approved Event-Day List" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="890" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Registration edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="start" target="basic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="basic" target="docCol">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="docCol" target="docVer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="docVer" target="docOk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#b85450;labelBackgroundColor=#f7f9fc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="docOk" target="docUpd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="Re-submit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;fontSize=11;fontColor=#b85450;labelBackgroundColor=#f7f9fc;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="docUpd" target="docCol">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontStyle=1;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="docOk" target="pay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="pay" target="payOk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="No / Interrupted" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#b85450;labelBackgroundColor=#f7f9fc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="payOk" target="draft">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="draft" target="resume">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="resume" target="pay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontStyle=1;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="payOk" target="regDone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="regDone" target="added">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= EVENT DAY ================= -->
        <mxCell id="evList" value="Approved Event-Day&lt;br&gt;Student List" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="1080" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="scan" value="Face Scan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="1190" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="match" value="Face Match?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="1280" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ident" value="Student Identified" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="1430" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="search" value="Search Student in&lt;br&gt;Admin Panel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="1305" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="manual" value="Manual Verification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="1430" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="present" value="Mark Present" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="1540" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="end" value="End" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="1640" width="220" height="40" as="geometry" />
        </mxCell>

        <!-- Key rules note -->
        <mxCell id="rules" value="&lt;b&gt;Key Rules&lt;/b&gt;&lt;br&gt;• Only students on the approved event-day list can proceed to the face scan.&lt;br&gt;• Face matching is the normal attendance flow.&lt;br&gt;• If the face match fails, the admin searches for the student and verifies them manually.&lt;br&gt;• Document verification is part of registration/compliance (manual, not automated)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa7b8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="1715" width="600" height="110" as="geometry" />
        </mxCell>

        <!-- Link between sections -->
        <mxCell id="link" value="Moves to event day" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f3a5f;dashed=1;fontSize=11;fontStyle=2;fontColor=#1f3a5f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="added" target="evList">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Event-day edges -->
        <mxCell id="f1" value="Approved students only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontSize=11;fontStyle=2;fontColor=#1f3a5f;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="evList" target="scan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="scan" target="match">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontStyle=1;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="match" target="ident">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#b85450;labelBackgroundColor=#f7f9fc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="match" target="search">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;" edge="1" parent="1" source="search" target="manual">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="ident" target="present">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="manual" target="present">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="present" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
