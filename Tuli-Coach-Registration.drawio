        <mxCell id="pending" value="Status Stays&lt;br&gt;Pending" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="485" width="135" height="50" as="geometry" /></mxCell>
