        <mxCell id="c6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontStyle=1;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="allUp" target="submitted"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="await" value="Pending Admin&lt;br&gt;Verification" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="140" width="190" height="50" as="geometry" /></mxCell>
