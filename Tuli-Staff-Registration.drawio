<mxfile host="app.diagrams.net">
  <diagram id="tuli-staff" name="Staff Registration">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="710" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Tuli – Staff Registration Workflow" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f3a5f;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1280" height="40" as="geometry" /></mxCell>
        <mxCell id="bg0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#c9d3e0;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="400" height="470" as="geometry" /></mxCell>
        <mxCell id="hdr0" value="&lt;b&gt;1. REGISTRATION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Personal details, role, photo &amp;amp; background proof&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="bg1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#c9d3e0;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="400" height="470" as="geometry" /></mxCell>
        <mxCell id="hdr1" value="&lt;b&gt;2. ADMIN VERIFICATION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Approve / reject&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="bg2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#c9d3e0;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="400" height="470" as="geometry" /></mxCell>
        <mxCell id="hdr2" value="&lt;b&gt;3. EVENT-DAY ACCESS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;&quot;&gt;Face scan &amp;amp; staff card&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="start" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="190" height="40" as="geometry" /></mxCell>
        <mxCell id="reg" value="&lt;b&gt;Register&lt;/b&gt;&lt;div style=&quot;text-align:left;padding-left:18px;margin-top:6px;&quot;&gt;1. Personal details&lt;br&gt;2. Role / function&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="photo" value="&lt;b&gt;Photo &amp;amp; Background Proof&lt;/b&gt;&lt;div style=&quot;text-align:left;padding-left:18px;margin-top:6px;&quot;&gt;1. Live photo&lt;br&gt;2. Background-check reference&lt;br&gt;&lt;i&gt;(check performed externally)&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="320" width="190" height="115" as="geometry" /></mxCell>
        <mxCell id="submitted" value="Registration&lt;br&gt;Submitted" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="465" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="s1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="start" target="reg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="reg" target="photo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="photo" target="submitted"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="await" value="Pending Admin&lt;br&gt;Verification" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="140" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="review" value="Admin Verification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="220" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="ok" value="Approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="300" width="190" height="100" as="geometry" /></mxCell>
        <mxCell id="rejected" value="Registration&lt;br&gt;Rejected" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="325" width="135" height="50" as="geometry" /></mxCell>
        <mxCell id="approve" value="Mark as Approved" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="440" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="await" target="review"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="review" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a3" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#b85450;labelBackgroundColor=#f7f9fc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ok" target="rejected"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="a4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontStyle=1;fontSize=12;fontColor=#2e7d32;labelBackgroundColor=#f7f9fc;" edge="1" parent="1" source="ok" target="approve"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="approved" value="Staff Approved" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="140" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="scan" value="Face Scan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="220" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="card" value="Staff-Colored Card" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="300" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="end" value="End" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="950" y="380" width="190" height="40" as="geometry" /></mxCell>
        <mxCell id="x1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="approved" target="scan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="x2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="scan" target="card"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="x3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;" edge="1" parent="1" source="card" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f3a5f;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="submitted" target="await"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="490" /><mxPoint x="460" y="165" /></Array></mxGeometry></mxCell>
        <mxCell id="l2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f3a5f;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="approve" target="approved"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="465" /><mxPoint x="900" y="165" /></Array></mxGeometry></mxCell>
        <mxCell id="rules" value="&lt;b&gt;Key Rules&lt;/b&gt;&lt;br&gt;• Staff register with personal details and their role / function.&lt;br&gt;• A live photo and a background-check reference are required; the background check is performed externally.&lt;br&gt;• The admin approves or rejects each staff registration.&lt;br&gt;• On event day, approved staff go through the face scan and receive a staff-colored card." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa7b8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="820" height="110" as="geometry" /></mxCell>
        <mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa7b8;" vertex="1" parent="1"><mxGeometry x="880" y="570" width="440" height="110" as="geometry" /></mxCell>
        <mxCell id="lgTitle" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="895" y="575" width="120" height="24" as="geometry" /></mxCell>
        <mxCell id="lg1" value="" style="rounded=1;arcSize=50;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="900" y="606" width="50" height="24" as="geometry" /></mxCell>
