<mxfile host="app.diagrams.net" modified="2026-10-08T00:00:00.000Z" agent="Claude Code" version="24.0.0"><diagram name="1 - System architecture" id="1-system-architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Face-X: backend architecture" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Youth football registration and event-day check-in. How the pieces fit together, what is done, and where it runs (Hetzner: see page 3)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1100" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Who uses it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#FAFAFA;strokeColor=#B5B5B5;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="290" height="400" as="geometry"/></mxCell><mxCell id="c5" value="Family web app (Next.js PWA)&lt;br&gt;Player registration: sign-up, guardian &amp; consent, photo &amp; documents, payment, status dashboard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="260" height="90" as="geometry"/></mxCell><mxCell id="c6" value="Admin portal&lt;br&gt;Review documents, approve / reject, registration lists, event-day reports&lt;br&gt;(screens built; connecting to the API next)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFF1D6;strokeColor=#D9922B;fontColor=#5A3A05;" vertex="1" parent="1"><mxGeometry x="55" y="230" width="260" height="100" as="geometry"/></mxCell><mxCell id="c7" value="Event-day scanner (face + manual, works offline)&lt;br&gt;(screens built; face provider not chosen, offline sync not built)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFF1D6;strokeColor=#D9922B;fontColor=#5A3A05;" vertex="1" parent="1"><mxGeometry x="55" y="345" width="260" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Coach &amp; Staff registration&lt;br&gt;(screens built; backend not started)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="55" y="427" width="260" height="50" as="geometry"/></mxCell><mxCell id="c9" value="Web server proxy&lt;br&gt;Browser only talks to its own /api/v1; keeps the login cookie first-party" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="345" y="125" width="100" height="290" as="geometry"/></mxCell><mxCell id="c10" value="Face-X API   (Node 22 · Express 5 · TypeScript, REST /api/v1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#F7FBF8;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="560" height="720" as="geometry"/></mxCell><mxCell id="c11" value="Platform safeguards on every request&lt;br&gt;Security headers · CORS allow-list · rate limits (login, uploads, payment, scan) · request IDs · structured logs with no personal data" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="495" y="125" width="530" height="52" as="geometry"/></mxCell><mxCell id="c12" value="Access control&lt;br&gt;JWT access token (15 min) + rotating refresh token in an HttpOnly cookie · roles ADMIN / COACH / STAFF / PARENT / PLAYER · event-level access · input validation (Zod) · one standard error format" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="495" y="185" width="530" height="62" as="geometry"/></mxCell><mxCell id="c13" value="Accounts &amp; login&lt;br&gt;sign-up, sign-in, refresh, sign-out" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="495" y="262" width="165" height="62" as="geometry"/></mxCell><mxCell id="c14" value="Onboarding&lt;br&gt;family picks PARENT / PLAYER (never admin)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="670" y="262" width="165" height="62" as="geometry"/></mxCell><mxCell id="c15" value="Catalog&lt;br&gt;events, teams, coach invite links" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="845" y="262" width="165" height="62" as="geometry"/></mxCell><mxCell id="c16" value="Players &amp; guardians&lt;br&gt;own children / self, guardian records" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="495" y="334" width="165" height="62" as="geometry"/></mxCell><mxCell id="c17" value="Registrations&lt;br&gt;status workflow + full history, duplicates blocked" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="670" y="334" width="165" height="62" as="geometry"/></mxCell><mxCell id="c18" value="Documents&lt;br&gt;signed uploads, file checks, admin review, re-upload" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="845" y="334" width="165" height="62" as="geometry"/></mxCell><mxCell id="c19" value="Consent&lt;br&gt;versioned wording, who accepted which version" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="495" y="406" width="165" height="62" as="geometry"/></mxCell><mxCell id="c20" value="Payments&lt;br&gt;Stripe checkout, signed webhook is the only proof" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="670" y="406" width="165" height="62" as="geometry"/></mxCell><mxCell id="c21" value="Readiness&lt;br&gt;auto-advances to &quot;ready for event&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="845" y="406" width="165" height="62" as="geometry"/></mxCell><mxCell id="c22" value="Admin review&lt;br&gt;summary, filtered lists, review queue, reject" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="495" y="478" width="165" height="62" as="geometry"/></mxCell><mxCell id="c23" value="Event-day check-in&lt;br&gt;face scan, manual search, check-in (idempotent)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFF1D6;strokeColor=#D9922B;fontColor=#5A3A05;" vertex="1" parent="1"><mxGeometry x="670" y="478" width="165" height="62" as="geometry"/></mxCell><mxCell id="c24" value="Face enrollment&lt;br&gt;profile photo to provider, consent required" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFF1D6;strokeColor=#D9922B;fontColor=#5A3A05;" vertex="1" parent="1"><mxGeometry x="845" y="478" width="165" height="62" as="geometry"/></mxCell><mxCell id="c25" value="Planned (not started)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontStyle=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="495" y="552" width="300" height="16" as="geometry"/></mxCell><mxCell id="c26" value="Coach &amp; Staff registration" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="495" y="572" width="165" height="44" as="geometry"/></mxCell><mxCell id="c27" value="Offline check-in sync" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="670" y="572" width="165" height="44" as="geometry"/></mxCell><mxCell id="c28" value="Event access toggle, attendance reports" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="845" y="572" width="165" height="44" as="geometry"/></mxCell><mxCell id="c29" value="Notifications (email / SMS)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="495" y="624" width="165" height="44" as="geometry"/></mxCell><mxCell id="c30" value="Password reset, email verification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="670" y="624" width="165" height="44" as="geometry"/></mxCell><mxCell id="c31" value="Refund handling" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="845" y="624" width="165" height="44" as="geometry"/></mxCell><mxCell id="c32" value="Audit log: every sensitive action is recorded (who, what, when, from where)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="495" y="735" width="530" height="56" as="geometry"/></mxCell><mxCell id="c33" value="Data   (PostgreSQL on Hetzner)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#F6F2FB;strokeColor=#6C4FB0;fontColor=#2E1F5E;" vertex="1" parent="1"><mxGeometry x="1120" y="90" width="330" height="400" as="geometry"/></mxCell><mxCell id="c34" value="Accounts · roles · refresh sessions&lt;br&gt;Organizations · events · teams (invite codes)&lt;br&gt;Players · guardians&lt;br&gt;Registrations + status history (append-only)&lt;br&gt;Documents + reviews&lt;br&gt;Consent wording (immutable) + acceptances&lt;br&gt;Payments + webhook events (de-duplicated)&lt;br&gt;Face profiles · scans · check-ins&lt;br&gt;Audit log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#EDE7F6;strokeColor=#6C4FB0;fontColor=#2E1F5E;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1135" y="125" width="300" height="190" as="geometry"/></mxCell><mxCell id="c35" value="Guarantees enforced by the database itself:&lt;br&gt;· one registration per player per event&lt;br&gt;· consent text and history can never be edited&lt;br&gt;· one paid payment per registration&lt;br&gt;· a check-in only for a ready registration" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontColor=#2E1F5E;" vertex="1" parent="1"><mxGeometry x="1135" y="325" width="300" height="120" as="geometry"/></mxCell><mxCell id="c36" value="Outside services  (Hetzner Object Storage + third parties)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#F3F8FE;strokeColor=#3B78C4;fontColor=#14325C;" vertex="1" parent="1"><mxGeometry x="1120" y="510" width="330" height="300" as="geometry"/></mxCell><mxCell id="c37" value="Stripe (hosted checkout)&lt;br&gt;Card details never touch our systems" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E4EEFB;strokeColor=#3B78C4;fontColor=#14325C;" vertex="1" parent="1"><mxGeometry x="1135" y="545" width="300" height="56" as="geometry"/></mxCell><mxCell id="c38" value="Hetzner Object Storage (S3-compatible, private bucket)&lt;br&gt;Documents and photos. Families upload straight to it with a short-lived signed link; nothing is public" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E4EEFB;strokeColor=#3B78C4;fontColor=#14325C;" vertex="1" parent="1"><mxGeometry x="1135" y="612" width="300" height="66" as="geometry"/></mxCell><mxCell id="c39" value="Face recognition provider&lt;br&gt;(not chosen yet)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="1135" y="689" width="300" height="50" as="geometry"/></mxCell><mxCell id="c40" value="Email / SMS provider&lt;br&gt;(planned)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="1135" y="747" width="300" height="44" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.155;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.534;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.879;dashed=1;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="reads / writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;entryX=0;entryY=0.25;strokeColor=#6C4FB0;strokeWidth=2;" edge="1" parent="1" source="c10" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="create checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.657;entryX=0;entryY=0.3;strokeColor=#3B78C4;" edge="1" parent="1" source="c10" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="signed webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;entryX=1;entryY=0.694;strokeColor=#3B78C4;dashed=1;" edge="1" parent="1" source="c37" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="signed links" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.77;entryX=0;entryY=0.5;strokeColor=#3B78C4;" edge="1" parent="1" source="c10" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="enroll / scan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.867;entryX=0;entryY=0.5;strokeColor=#9A9A9A;dashed=1;" edge="1" parent="1" source="c10" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B5B5B5;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="290" height="300" as="geometry"/></mxCell><mxCell id="c51" value="Done: built and automatically tested" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="55" y="545" width="260" height="34" as="geometry"/></mxCell><mxCell id="c52" value="Built, waiting on a decision or connection" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFF1D6;strokeColor=#D9922B;fontColor=#5A3A05;" vertex="1" parent="1"><mxGeometry x="55" y="589" width="260" height="34" as="geometry"/></mxCell><mxCell id="c53" value="Planned: not started" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="55" y="633" width="260" height="34" as="geometry"/></mxCell><mxCell id="c54" value="External service" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E4EEFB;strokeColor=#3B78C4;fontColor=#14325C;" vertex="1" parent="1"><mxGeometry x="55" y="677" width="260" height="34" as="geometry"/></mxCell><mxCell id="c55" value="Status as of this version: 576 automated backend tests pass. The player registration flow is connected to this API and tested end to end in a browser. Real Stripe, Hetzner Object Storage and a real-device camera check are still to be run." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="55" y="722" width="260" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 - Player registration lifecycle" id="2-player-registration-lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Player registration lifecycle" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Every status change is recorded with who or what caused it. Payment, documents and consent are tracked separately and drive the status." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1300" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Draft" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E4EEFB;strokeColor=#3B78C4;fontColor=#14325C;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="150" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Submitted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E4EEFB;strokeColor=#3B78C4;fontColor=#14325C;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="150" width="150" height="56" as="geometry"/></mxCell><mxCell id="c6" value="Payment pending" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E4EEFB;strokeColor=#3B78C4;fontColor=#14325C;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="150" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Payment completed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E4EEFB;strokeColor=#3B78C4;fontColor=#14325C;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="150" width="150" height="56" as="geometry"/></mxCell><mxCell id="c8" value="Document review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E4EEFB;strokeColor=#3B78C4;fontColor=#14325C;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="150" height="56" as="geometry"/></mxCell><mxCell id="c9" value="Verified" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E4EEFB;strokeColor=#3B78C4;fontColor=#14325C;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="990" y="150" width="150" height="56" as="geometry"/></mxCell><mxCell id="c10" value="Ready for event" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="150" height="56" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="Family fills in the form&lt;br&gt;(player, guardian, consent)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;fontColor=#444444;align=center;" vertex="1" parent="1"><mxGeometry x="35" y="216" width="170" height="70" as="geometry"/></mxCell><mxCell id="c18" value="Family submits:&lt;br&gt;team chosen, guardian present&lt;br&gt;for under-18s. Fee is fixed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;fontColor=#444444;align=center;" vertex="1" parent="1"><mxGeometry x="225" y="216" width="170" height="70" as="geometry"/></mxCell><mxCell id="c19" value="Family starts Stripe checkout" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;fontColor=#444444;align=center;" vertex="1" parent="1"><mxGeometry x="415" y="216" width="170" height="70" as="geometry"/></mxCell><mxCell id="c20" value="Stripe's signed webhook&lt;br&gt;confirms payment&lt;br&gt;(the browser redirect never counts)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;fontColor=#444444;align=center;" vertex="1" parent="1"><mxGeometry x="605" y="216" width="170" height="70" as="geometry"/></mxCell><mxCell id="c21" value="All required documents&lt;br&gt;uploaded and sent for review" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;fontColor=#444444;align=center;" vertex="1" parent="1"><mxGeometry x="795" y="216" width="170" height="70" as="geometry"/></mxCell><mxCell id="c22" value="Admin approves&lt;br&gt;every required document" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;fontColor=#444444;align=center;" vertex="1" parent="1"><mxGeometry x="985" y="216" width="170" height="70" as="geometry"/></mxCell><mxCell id="c23" value="Payment + documents + consent&lt;br&gt;all complete: automatic" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;fontColor=#444444;align=center;" vertex="1" parent="1"><mxGeometry x="1175" y="216" width="170" height="70" as="geometry"/></mxCell><mxCell id="c24" value="Rejected (can happen from Submitted, Document review or Verified)&lt;br&gt;Admin decision with a written reason the family can read. Final for now: a rejected registration is frozen and cannot be revived." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FDE8E8;strokeColor=#C0392B;fontColor=#6B1A12;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="330" height="80" as="geometry"/></mxCell><mxCell id="c25" value="Cancelled&lt;br&gt;Ends the registration (not yet exposed in the app)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FDE8E8;strokeColor=#C0392B;fontColor=#6B1A12;" vertex="1" parent="1"><mxGeometry x="700" y="330" width="300" height="80" as="geometry"/></mxCell><mxCell id="c26" value="A document's own life (per required document)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#FAFAFA;strokeColor=#B5B5B5;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1280" height="190" as="geometry"/></mxCell><mxCell id="c27" value="Awaiting upload" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="495" width="190" height="64" as="geometry"/></mxCell><mxCell id="c28" value="Uploaded&lt;br&gt;server checked size + real file type" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="495" width="190" height="64" as="geometry"/></mxCell><mxCell id="c29" value="In review&lt;br&gt;family sent it to staff" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="500" y="495" width="190" height="64" as="geometry"/></mxCell><mxCell id="c30" value="Approved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="730" y="495" width="190" height="64" as="geometry"/></mxCell><mxCell id="c31" value="Rejected&lt;br&gt;with reason code + text" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FDE8E8;strokeColor=#C0392B;fontColor=#6B1A12;" vertex="1" parent="1"><mxGeometry x="960" y="495" width="190" height="64" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#C0392B;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c29" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="family replaces the file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2F8F5B;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c31" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="Uploads go directly to private storage using a short-lived signed link. The API then verifies the stored file before it counts. Unsupported or disguised files (for example HTML renamed to .pdf) are refused." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="575" width="1180" height="50" as="geometry"/></mxCell><mxCell id="c39" value="Event day" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#FFF8EA;strokeColor=#D9922B;fontColor=#5A3A05;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1280" height="130" as="geometry"/></mxCell><mxCell id="c40" value="A player can be checked in only if their registration is READY_FOR_EVENT, their event access is switched on, payment, documents and consent are still complete at that moment, and they are not already checked in.&lt;br&gt;Check-in by face scan (needs the face provider) or by manual search. Each check-in carries a unique request id, so a retry after a bad connection never creates a duplicate." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontColor=#5A3A05;" vertex="1" parent="1"><mxGeometry x="60" y="705" width="1190" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 - Hosting on Hetzner" id="3-hosting-on-hetzner"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Hosting on Hetzner" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Proposed layout: everything runs on Hetzner except payment, email/SMS and the face-recognition provider. Items marked &quot;confirm&quot; need a decision." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1350" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Families, admins and event-day staff&lt;br&gt;&lt;br&gt;Phones and laptops (browser / installed web app)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="200" height="130" as="geometry"/></mxCell><mxCell id="c5" value="Hetzner Cloud   (private network + cloud firewall: only ports 80/443 are open to the internet)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#FDF3F3;strokeColor=#D50C2D;fontColor=#8A0A1E;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="600" height="700" as="geometry"/></mxCell><mxCell id="c6" value="Load balancer / reverse proxy&lt;br&gt;HTTPS certificates, one public address, routes traffic to the web app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#FFFFFF;strokeColor=#8A8A8A;fontColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="135" width="500" height="66" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B5B5B5;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="225" width="520" height="180" as="geometry"/></mxCell><mxCell id="c8" value="Application server(s) · Docker" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=11;fontStyle=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="345" y="382" width="200" height="18" as="geometry"/></mxCell><mxCell id="c9" value="Web app (Next.js)&lt;br&gt;The screens families and admins see. Forwards /api/v1 to the API." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="345" y="270" width="230" height="110" as="geometry"/></mxCell><mxCell id="c10" value="Face-X API (Node 22)&lt;br&gt;All business rules, access control, payments, documents, readiness, check-in" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E3F4EA;strokeColor=#2F8F5B;fontColor=#12402A;" vertex="1" parent="1"><mxGeometry x="610" y="270" width="230" height="110" as="geometry"/></mxCell><mxCell id="c11" value="PostgreSQL database&lt;br&gt;Cloud server + attached Volume, reachable only on the private network&lt;br&gt;(confirm: self-managed, see notes)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#EDE7F6;strokeColor=#6C4FB0;fontColor=#2E1F5E;" vertex="1" parent="1"><mxGeometry x="340" y="450" width="230" height="120" as="geometry"/></mxCell><mxCell id="c12" value="Backups&lt;br&gt;Daily Hetzner server backup + nightly database dump copied to Object Storage; restore tested before launch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#EDE7F6;strokeColor=#6C4FB0;fontColor=#2E1F5E;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="585" width="230" height="80" as="geometry"/></mxCell><mxCell id="c13" value="Hetzner Object Storage&lt;br&gt;Private bucket for documents and photos.&lt;br&gt;Browsers upload directly with a short-lived signed link; only our site is allowed by CORS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E4EEFB;strokeColor=#3B78C4;fontColor=#14325C;" vertex="1" parent="1"><mxGeometry x="610" y="450" width="230" height="120" as="geometry"/></mxCell><mxCell id="c14" value="Optional later: second app server behind the load balancer (needs a shared store for rate limits)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="585" width="230" height="80" as="geometry"/></mxCell><mxCell id="c15" value="Operations   (planned)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B5B5B5;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="330" y="685" width="520" height="90" as="geometry"/></mxCell><mxCell id="c16" value="Deploy pipeline&lt;br&gt;GitHub &gt; automated tests &gt; container image &gt; deploy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="345" y="715" width="240" height="50" as="geometry"/></mxCell><mxCell id="c17" value="Monitoring &amp; alerts&lt;br&gt;server metrics, uptime, error logs (no personal data)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="715" width="240" height="50" as="geometry"/></mxCell><mxCell id="c18" value="Outside Hetzner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#F3F8FE;strokeColor=#3B78C4;fontColor=#14325C;" vertex="1" parent="1"><mxGeometry x="930" y="90" width="480" height="330" as="geometry"/></mxCell><mxCell id="c19" value="Stripe&lt;br&gt;hosted checkout; card data never touches us; signed webhook confirms payment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#E4EEFB;strokeColor=#3B78C4;fontColor=#14325C;" vertex="1" parent="1"><mxGeometry x="945" y="270" width="210" height="120" as="geometry"/></mxCell><mxCell id="c20" value="Email / SMS provider&lt;br&gt;(planned; Hetzner does not offer one: confirm provider)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1175" y="130" width="220" height="56" as="geometry"/></mxCell><mxCell id="c21" value="Face recognition provider&lt;br&gt;(not chosen yet)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;verticalAlign=middle;align=center;spacing=6;fillColor=#F1F1F1;strokeColor=#9A9A9A;fontColor=#555555;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1175" y="196" width="220" height="54" as="geometry"/></mxCell><mxCell id="c22" value="Payments and the face provider are called from the API server only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1175" y="270" width="220" height="60" as="geometry"/></mxCell><mxCell id="c23" value="Points to confirm with the client" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#FFF8EA;strokeColor=#D9922B;fontColor=#5A3A05;" vertex="1" parent="1"><mxGeometry x="930" y="440" width="480" height="350" as="geometry"/></mxCell><mxCell id="c24" value="1. Database: Hetzner has no managed PostgreSQL, so we run and back it up ourselves (updates, monitoring, restore drills). Budget for this.&lt;br&gt;&lt;br&gt;2. Region and data residency: the users are in California and the data is about minors. Choose the server region deliberately; Object Storage is offered in EU locations (verify current availability), so decide whether documents may be stored in the EU.&lt;br&gt;&lt;br&gt;3. Email and SMS: not provided by Hetzner; a third-party sender is needed for notifications.&lt;br&gt;&lt;br&gt;4. Scale: one API server is enough to start. More than one needs a shared store for rate limits.&lt;br&gt;&lt;br&gt;5. Secrets (database password, Stripe keys, storage keys) live in server environment/secret storage, never in the code.&lt;br&gt;&lt;br&gt;6. Bucket CORS must allow only our website address (uploads are sent from the browser)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=10;fontColor=#5A3A05;" vertex="1" parent="1"><mxGeometry x="945" y="478" width="450" height="300" as="geometry"/></mxCell><mxCell id="c25" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.24;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="/api/v1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="reads / writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.75;entryY=0;strokeColor=#6C4FB0;strokeWidth=2;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="signed links, file checks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.5;entryY=0;strokeColor=#3B78C4;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6C4FB0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="create checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.18;strokeColor=#3B78C4;" edge="1" parent="1" source="c10" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="signed webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.73;entryX=1;entryY=0.8;strokeColor=#3B78C4;dashed=1;" edge="1" parent="1" source="c19" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>